# コピーして .dev.vars を作り、値を入れる。
#   cp apps/api/.dev.vars.example apps/api/.dev.vars
# .dev.vars はコミットしない。

LINE_CHANNEL_ID=
LINE_CHANNEL_SECRET=
LINE_MESSAGING_CHANNEL_SECRET=
LINE_CHANNEL_ACCESS_TOKEN=
SESSION_SECRET=
APP_URL=http://127.0.0.1:5173

# Notion。任意。空なら Notion には書かず、通知も送らない（D1 への保存は続く）。手順は docs/backend-setup.md の「Notion」。
NOTION_TOKEN=
NOTION_DATA_SOURCE_ID=

# LINE 通知の送り先の LINE ユーザーID。任意。空なら通知しない。読み先は Notion なので、Notion の 2 つも要る。
NOTIFY_LINE_USER_ID=
# 通知の「他N件」から開く Notion のページの URL。任意。空なら APP_URL。
NOTION_VIEW_URL=
